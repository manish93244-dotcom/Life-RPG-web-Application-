# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key used to sign and verify user authentication tokens.
JWT_SECRET="cyberpunk_life_rpg_super_secret_jwt_key_2026"

# DATABASE_URL: Connection string for PostgreSQL database when deploying with Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/liferpg?schema=public"
